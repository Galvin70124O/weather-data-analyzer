# Copy to .env (repo root) and fill in. .env is git-ignored: never commit real values.

# Your Neon DEV branch (local development). Neon gives "postgresql://...?sslmode=require".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-dev.REGION.aws.neon.tech/weather?sslmode=require

# A SEPARATE Neon branch for the tests. The tests wipe it, so they refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-test.REGION.aws.neon.tech/weather?sslmode=require

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# development | test | production
ENVIRONMENT=development
# true in production (cookie only sent over HTTPS)
COOKIE_SECURE=false

# Phase 2: OpenWeatherMap key (server only, never sent to the browser)
OPENWEATHER_API_KEY=your_openweathermap_key

# Optional alternative to Neon: the docker-compose Postgres
# DATABASE_URL=postgresql://weather:weather@localhost:5432/weather
# TEST_DATABASE_URL=postgresql://weather:weather@localhost:5432/weather_test
